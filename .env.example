# Copy to .env (git-ignored) and adjust. Real environment variables override this file.

# Django secret key. Required when DEBUG is False; generate one for every deployment.
SECRET_KEY=change-me

# Debug mode (True/False). Defaults to False when unset; never enable it in production.
DEBUG=True

# Comma-separated host names the app may serve. Defaults to localhost,127.0.0.1.
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI API key for the AI summaries; read by the OpenAI client service (#14).
OPENAI_API_KEY=

# Optional OpenAI model override, also read in #14.
OPENAI_MODEL=
